# Достатньо ОДНОГО ключа. Провайдери пробуються в порядку ланцюжка,
# а всередині провайдера — по черзі всі його ключі.
# Скопіюй цей файл у .env і впиши свої.

GROQ_API_KEY=
OPENROUTER_API_KEY=

# Другий і наступні ключі того самого провайдера: _2, _3, … до _10.
#
# Це захист не від падіння провайдера (там другий ключ марний), а від
# лімітів, прив'язаних до облікового запису: денна квота безкоштовних
# моделей OpenRouter вичерпується на ключ і одразу на всі його моделі.
# Другий ключ від іншого акаунта дає ще один такий самий добовий бюджет.
#
# GROQ_API_KEY_2=
# OPENROUTER_API_KEY_2=

# Необовʼязково: перекрити модель за замовчуванням
# MONO_AGENT_MODEL=

# Офлайн-режим: ганяти граф без ключа й без витрат (модель не викликається)
# MONO_AGENT_FAKE_LLM=1

# Тестовий гачок: змусити самоперевірку сказати «контексту бракує»
# MONO_AGENT_FAKE_UNGROUNDED=1
