# Достатньо ОДНОГО ключа — провайдер визначається автоматично,
# у порядку: Groq → OpenRouter → Anthropic → OpenAI.
# Скопіюй цей файл у .env і впиши свій ключ.

GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Необовʼязково: перекрити модель за замовчуванням
# MONO_AGENT_MODEL=llama-3.3-70b-versatile

# Офлайн-режим:ганяти граф без ключа й без витрат (модель не викликається)
# MONO_AGENT_FAKE_LLM=1
